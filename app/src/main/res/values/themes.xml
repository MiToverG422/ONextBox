<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ONextBox" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/coui_launch_background</item>
        <item name="android:colorAccent">@color/coui_launch_background</item>
        <item name="android:statusBarColor">@color/coui_launch_background</item>
        <item name="android:navigationBarColor">@color/coui_launch_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.ONextBox.Onboarding" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
