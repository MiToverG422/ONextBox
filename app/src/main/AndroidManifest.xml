<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk tools:overrideLibrary="io.github.suqi8.coui.kmp.blur" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
        <intent>
            <action android:name="android.content.pm.action.CONFIRM_INSTALL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DELETE" />
            <data android:scheme="package" />
        </intent>
        <intent>
            <action android:name="android.intent.action.UNINSTALL_PACKAGE" />
            <data android:scheme="package" />
        </intent>
        <package android:name="com.android.permissioncontroller" />
        <package android:name="com.google.android.permissioncontroller" />
        <package android:name="com.oplus.securitypermission" />
        <package android:name="org.lsposed.manager" />
        <package android:name="io.github.libxposed.manager" />
        <package android:name="com.android.systemui" />
        <package android:name="com.android.settings" />
        <package android:name="com.oplus.athena" />
        <package android:name="com.oplus.screenshot" />
        <package android:name="com.coloros.screenshot" />
        <package android:name="com.oplus.screenrecorder" />
        <package android:name="com.coloros.screenrecorder" />
        <package android:name="com.android.launcher" />
        <package android:name="com.android.launcher3" />
        <package android:name="com.oplus.wallpapers" />
        <package android:name="com.oplus.launcher" />
        <package android:name="com.oneplus.launcher" />
        <package android:name="com.oplus.aod" />
        <package android:name="com.oplus.euicc" />
        <package android:name="com.heytap.market" />
        <package android:name="com.coloros.filemanager" />
        <package android:name="com.heytap.mcs" />
        <package android:name="com.nearme.instant.platform" />
        <package android:name="com.coloros.assistantscreen" />
        <intent>
            <action android:name="com.heytap.mcs.action.RECEIVE_MCS_MESSAGE" />
        </intent>
        <intent>
            <action android:name="com.heytap.msp.push.RECEIVE_MCS_MESSAGE" />
        </intent>
        <intent>
            <action android:name="com.coloros.mcs.action.RECEIVE_MCS_MESSAGE" />
        </intent>
        <package android:name="com.google.android.apps.messaging" />
        <package android:name="com.android.phone" />
        <package android:name="com.oneplus.aod" />
        <package android:name="com.coloros.aod" />
        <package android:name="com.heytap.speechassist" />
        <package android:name="com.coloros.speechassist" />
        <package android:name="com.oplus.speechassist" />
        <package android:name="com.google.android.googlequicksearchbox" />
        <package android:name="android" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="lsposed" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <permission android:name="${applicationId}.permission.PUSH_MONITOR" android:protectionLevel="signature" />
    <uses-permission android:name="${applicationId}.permission.PUSH_MONITOR" />

    <application
        android:name=".ONextBoxApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:description="@string/xposed_description"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ONextBox">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ONextBox"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".OnboardingActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="locked"
            android:theme="@style/Theme.ONextBox.Onboarding" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".ui.settings.UpdateCheckJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <provider
            android:name=".push.PushMonitorProvider"
            android:authorities="${applicationId}.pushmonitor"
            android:directBootAware="true"
            android:exported="true" />

        <receiver
            android:name=".boot.BootSyncReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
